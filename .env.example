# Azure Storage Configuration
# Get these values from your Azure Storage Account
AZURE_CONNECTION_STRING=your_azure_storage_connection_string_here
AZURE_CONTAINER_NAME=video
# Studio history uses the same connection string.
# It creates tables StudioSettings / StudioChats / StudioMemories
# and a blob container named studio.

# Private studio at /ai. One account. Never commit real values.
# Username defaults to fergus when AI_USERNAME is unset.
AI_USERNAME=fergus
# python scripts/hash_ai_password.py
AI_PASSWORD_HASH=
# python -c "import secrets; print(secrets.token_urlsafe(48))"
AI_SESSION_SECRET=

# Model connection. Azure OpenAI is used when all three Azure values are set.
# Otherwise the studio uses OPENAI_API_KEY.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Completion budget for studio replies. Reasoning models share this with hidden thinking.
# AI_MAX_TOKENS=8192
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Hevy training log for the studio. The key is a Hevy PRO API key:
# https://hevy.com/settings?developer
# HEVY_API_KEY=
# HEVY_MCP_URL=https://mcp.hevy-mcp.dev/mcp 